# Copie para .env (cp .env.example .env). O arquivo .env NUNCA deve ser versionado.
# Use apenas letras e números nas senhas (elas entram em URIs de conexão).

# --- MongoDB -----------------------------------------------------------------
MONGO_USER=admin
MONGO_PASSWORD=MongoDev2026

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=RedisDev2026

# --- Neo4j (mínimo 8 caracteres) ---------------------------------------------
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=Neo4jDev2026
NEO4J_DATABASE=neo4j
# Para usar o Neo4j AuraDB em vez do container local, defina a URI da instância:
# NEO4J_URI=neo4j+s://<id-da-instancia>.databases.neo4j.io

# --- Portas publicadas no host (mude se alguma já estiver em uso) ------------
# MONGO_HOST_PORT=27017
# REDIS_HOST_PORT=6380   # (se rodar Python fora do Docker, defina também REDIS_PORT com o mesmo valor)
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687
# APP_PORT=8501

# --- Aplicação ---------------------------------------------------------------
# Senha dos usuários de demonstração criados pelo seed (ambiente acadêmico)
SEED_SENHA_DEMO=Hosp2026demo
# Exibe os usuários de demonstração na tela de login (desligue fora da sala de aula)
DEMO_MODE=true
# Tempo de vida da sessão (sliding) em segundos
SESSION_TTL_SECONDS=1800
